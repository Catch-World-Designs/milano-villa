# Public canonical origin used for metadata, sitemap.xml and structured data.
# Set this to the final HTTPS domain with no trailing slash.
VITE_SITE_URL=https://your-domain.example

# Hosting path. Use / for a custom domain, or /repository-name/ for GitHub project Pages.
VITE_BASE_PATH=/

# Optional same-origin or HTTPS endpoint for contact submissions.
# Leave empty until a form handler has been deployed.
VITE_CONTACT_ENDPOINT=

